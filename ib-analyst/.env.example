# Copy this file to ".env" (same folder) and paste your Gemini API key after the = sign.
# The .env file is private: it is excluded from git and never shown by the app.
GEMINI_API_KEY=paste-your-key-here

# Optional settings
# IBA_GEMINI_MODEL=gemini-3.5-flash
# IBA_MAX_CONTEXT_CHARS=400000
# IBA_MAX_FILE_MB=50
